<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Vertical ViewPager for vertical scrolling between media items -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/media_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Center Play/Pause indicator -->
    <ImageView
        android:id="@+id/iv_center_indicator"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:contentDescription="@string/paused"
        android:src="@drawable/ic_pause_circle"
        android:visibility="gone"
        tools:alpha="1"
        tools:visibility="visible" />

    <!-- Left Skip Indicator (-5s) -->
    <LinearLayout
        android:id="@+id/indicator_skip_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="32dp"
        android:alpha="0"
        android:background="@drawable/bg_indicator_badge"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:alpha="1"
        tools:visibility="visible">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_replay_5"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="-5s"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Skip Indicator (+5s) -->
    <LinearLayout
        android:id="@+id/indicator_skip_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="32dp"
        android:alpha="0"
        android:background="@drawable/bg_indicator_badge"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:alpha="1"
        tools:visibility="visible">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_forward_5"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+5s"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top overlay buttons container -->
    <RelativeLayout
        android:id="@+id/top_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <!-- Volume/Mute status toast badge -->
        <LinearLayout
            android:id="@+id/volume_indicator_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:alpha="0"
            android:background="@drawable/bg_indicator_badge"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:alpha="1"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_volume_badge_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_volume_off"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_volume_badge_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muted"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Rotate Button -->
        <ImageButton
            android:id="@+id/btn_rotate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Rotate Screen"
            android:src="@drawable/ic_rotate"
            app:tint="@color/white" />
    </RelativeLayout>

    <!-- Bottom Progress Scrubbing Bar -->
    <LinearLayout
        android:id="@+id/bottom_scrubber_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_scrub_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="00:15 / 01:30"
            tools:visibility="visible" />

        <SeekBar
            android:id="@+id/bottom_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressBackgroundTint="#4DFFFFFF"
            android:progressTint="@color/white"
            android:thumbTint="@color/white" />
    </LinearLayout>

</FrameLayout>
